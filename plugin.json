{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notebook",
  "version": "0.1.0",
  "description": "A small notebook that demonstrates a Codex plugin with an OpenAI UI.",
  "license": "MIT",
  "author": { "name": "Fotis Adamakis" },
  "homepage": "https://github.com/fadamakis/codex-plugin-starter",
  "repository": "https://github.com/fadamakis/codex-plugin-starter",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Notebook",
        "shortDescription": "A space for your next idea",
        "longDescription": "Keep sample notes, find an idea, and save a favorite. An interactive starting point for building your own Codex plugin.",
        "developerName": "Fotis Adamakis",
        "category": "Developer Tools",
        "capabilities": ["Read", "Write", "Interactive"],
        "defaultPrompt": "Open Notebook and show my notes.",
        "websiteURL": "https://github.com/fadamakis/codex-plugin-starter",
        "logo": "./assets/icon.svg",
        "logoDark": "./assets/icon-dark.svg",
        "composerIcon": "./assets/icon.svg",
        "brandColor": "#6554D9"
      }
    }
  }
}
