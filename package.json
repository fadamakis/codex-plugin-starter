{
  "name": "codex-plugin-starter",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Fotis Adamakis",
  "repository": "https://github.com/fadamakis/codex-plugin-starter",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run smoke && npm run validate",
    "smoke": "node --import tsx scripts/smoke.ts",
    "validate": "node scripts/validate.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "configure": "node scripts/configure.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@openai/apps-sdk-ui": "0.2.2",
    "@openai/mcp-extensions": "0.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "lodash": "4.18.1",
    "katex": "0.19.1",
    "zod": "$zod"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
